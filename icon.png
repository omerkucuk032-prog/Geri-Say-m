from PIL import Image, ImageDraw

# Create a clean, high-quality 512x512 icon with solid PNG formatting
img = Image.new("RGBA", (512, 512), (25, 53, 65, 255))  # #193541 Dark Navy Background
draw = ImageDraw.Draw(img)

# Outer orange circle (#d86d4a)
draw.ellipse([96, 96, 416, 416], fill=(216, 109, 74, 255))
# Inner cream circle (#f4f0e7)
draw.ellipse([140, 140, 372, 372], fill=(244, 240, 231, 255))

# Clock hands (Dark Navy)
draw.line([256, 180, 256, 260], fill=(25, 53, 65, 255), width=16)
draw.line([256, 260, 310, 260], fill=(25, 53, 65, 255), width=16)
# Center dot
draw.ellipse([244, 248, 268, 272], fill=(25, 53, 65, 255))

# Save strictly as a standard, uncompressed/proper PNG
img.save("icon.png", "PNG")
print("icon.png successfully generated and saved!")
